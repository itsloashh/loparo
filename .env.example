# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://loparo.ca

# ── Supabase (leave blank to run on the bundled sample data) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications for new inquiries (optional) ──
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
INQUIRY_NOTIFY_FROM=LOASH <bookings@loparo.ca>

# ── Admin ──────────────────────────────────────────────
# Comma-separated emails allowed into /admin (or add rows to the `admins` table)
ADMIN_EMAILS=
# Local only: browse the admin UI on sample data without Supabase (ignored on Vercel)
ADMIN_DEMO=
